{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "Поддерживаемые персонажи (data/characters.json), заготовка",
  "description": "Каталог AM (XL позже). Превью хранятся у нас, а не ссылками на Google Sites.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "model", "variants"],
    "properties": {
      "id": { "type": "string", "pattern": "^chr_[A-Za-z0-9_-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "franchise": { "type": ["string", "null"] },
      "model": { "enum": ["am", "xl"] },
      "variants": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags"],
          "properties": {
            "label": { "type": ["string", "null"], "description": "Подпись наряда: стандарт, теннис, школа…" },
            "tags": { "type": "string", "minLength": 1, "description": "Строка тегов дословно, с экранированием \\( \\)" }
          }
        }
      },
      "media": { "type": "array", "items": { "type": "string" } },
      "source": { "type": "object" }
    }
  }
}
