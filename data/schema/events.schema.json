{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Архив ивентов (data/events.json), заготовка",
  "description": "Записи со страницы Events сообщества. Даты бывают с ошибками: ошибки помечаются в issues, а не правятся молча.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "author", "start"],
    "properties": {
      "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
      "title": { "type": "string", "minLength": 1 },
      "author": { "type": "string" },
      "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "end": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "null: ещё идёт или дата неизвестна" },
      "hashtag": { "type": ["string", "null"] },
      "results_url": { "type": ["string", "null"], "format": "uri" },
      "issues": {
        "type": "array",
        "items": { "enum": ["end_before_start", "missing_end", "year_mismatch", "unparsed_date"] },
        "description": "Что заподозрено в исходных датах"
      },
      "source": { "type": "object" }
    }
  }
}
