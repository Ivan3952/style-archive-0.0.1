{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mixes.schema.json",
  "title": "Миксы стилей (data/mixes.json), заготовка под обновление Foundation",
  "description": "Один пост-микс из Telegram: художники с весами, теги с весами и превью. prompt_raw хранится как есть: кнопка «копировать» отдаёт именно его.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "prompt_raw",
      "artists",
      "media"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^mix_[A-Za-z0-9_-]+$"
      },
      "title": {
        "type": "string",
        "description": "Название по хештегу поста, например besoebik_mixing"
      },
      "prompt_raw": {
        "type": "string",
        "minLength": 1,
        "description": "Строка тегов дословно"
      },
      "blend": {
        "enum": [
          "alternate",
          "sum"
        ],
        "description": "alternate: @[(a:1.4)|(b:1.3)]; sum: просто перечисление"
      },
      "artists": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "weight": {
              "type": "number"
            },
            "style_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "id стиля в архиве, если такой есть"
            }
          }
        }
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "weight": {
              "type": "number"
            }
          }
        }
      },
      "media": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": "string",
        "description": "Авторский текст поста (приветствие и т. п.), не данные"
      },
      "published_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "telegram",
              "manual"
            ]
          },
          "chat": {
            "type": "string"
          },
          "message_id": {
            "type": "integer"
          },
          "imported_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
